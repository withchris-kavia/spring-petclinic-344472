# Request the real values from the user/orchestrator environment manager.
# Do not commit real secrets or environment-specific values here.

# Base URL of the running Spring Petclinic application under test.
API_TEST_TARGET_BASE_URL=http://127.0.0.1:8080

# Artifact root used by the Node orchestration workspace.
API_TEST_OUTPUT_DIR=./artifacts

# Default timeout for orchestration operations and Playwright requests.
API_TEST_TIMEOUT_MS=30000

# Number of parallel workers for Playwright execution.
API_TEST_PARALLELISM=2

# Whether browser-backed Playwright execution should run headlessly.
API_TEST_HEADLESS=true

# Ignore HTTPS certificate errors when targeting local or self-signed environments.
API_TEST_IGNORE_HTTPS_ERRORS=false

# MCP transport settings for future integration work.
API_TEST_MCP_TRANSPORT=stdio
API_TEST_MCP_SERVER_COMMAND=
API_TEST_MCP_SERVER_ARGS=
